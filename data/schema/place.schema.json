{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LiveEarthPlace",
  "type": "object",
  "required": [
    "id",
    "name",
    "local_name",
    "country",
    "region",
    "latitude",
    "longitude",
    "category",
    "description",
    "highlights",
    "cameras"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z0-9\\-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "local_name": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "latitude": {
      "type": "number",
      "minimum": -90.0,
      "maximum": 90.0
    },
    "longitude": {
      "type": "number",
      "minimum": -180.0,
      "maximum": 180.0
    },
    "category": {
      "type": "string",
      "enum": [
        "mountain",
        "city",
        "coast",
        "transport",
        "culture",
        "wildlife",
        "special"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 350
    },
    "highlights": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "cameras": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
